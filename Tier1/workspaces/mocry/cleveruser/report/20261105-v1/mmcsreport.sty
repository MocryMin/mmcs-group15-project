%% mmcsreport.sty --- house style for the MMCS Group Project technical report
%% Design targets: sober consultancy typography, dense but airy results tables,
%% numbers-first opening, one accent colour. Compile with XeTeX / Tectonic.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mmcsreport}[2026/11/05 v1.0 MMCS technical report style]

% ---------------------------------------------------------------- fonts ----
% File-based loading only: on a machine without a fontconfig config file,
% name-based lookup (\setmainfont{TeX Gyre Pagella}) fails. File names work.
\RequirePackage{fontspec}
\setmainfont{texgyrepagella}[Extension=.otf,
  UprightFont=*-regular,BoldFont=*-bold,ItalicFont=*-italic,BoldItalicFont=*-bolditalic]
\setsansfont{texgyreheros}[Extension=.otf,
  UprightFont=*-regular,BoldFont=*-bold,ItalicFont=*-italic,BoldItalicFont=*-bolditalic]
\setmonofont{texgyrecursor}[Extension=.otf,UprightFont=*-regular,BoldFont=*-bold]
\RequirePackage[math-style=TeX]{unicode-math}
\setmathfont{texgyrepagella-math.otf}

% --------------------------------------------------------------- layout ----
\RequirePackage[a4paper,left=2.3cm,right=2.3cm,top=2.25cm,bottom=2.1cm,
  headheight=13pt,headsep=7mm,footskip=10mm]{geometry}
\RequirePackage{microtype}
\setlength{\parindent}{0pt}
\setlength{\parskip}{4.2pt plus 1.2pt minus 0.6pt}
\linespread{1.045}
\setlength{\emergencystretch}{2.5em}
\raggedbottom
\clubpenalty=1000 \widowpenalty=1000

% --------------------------------------------------------------- colour ----
\RequirePackage{xcolor}
\definecolor{ink}{HTML}{14171C}
\definecolor{accent}{HTML}{17456B}
\definecolor{warn}{HTML}{8C3A2B}
\definecolor{muted}{HTML}{5C6672}
\definecolor{rule}{HTML}{C3CDD8}
\definecolor{panel}{HTML}{EEF3F7}
\definecolor{panelwarn}{HTML}{F8F0EE}
\color{ink}

% ------------------------------------------------------------ hairlines ----
% \hrule sits in the vertical list, so it costs no baselineskip glue.
% \rule on its own line would add ~13pt of white above and below.
\newcommand{\hairrule}[1][0.5pt]{\par{\color{rule}\hrule height #1}\par}
\newcommand{\accentrule}[1][1.6pt]{\par{\color{accent}\hrule height #1}\par}

% ---------------------------------------------------------- table tools ----
\RequirePackage{booktabs,tabularx,array,multirow,makecell,threeparttable}
\RequirePackage{float}
\RequirePackage{needspace}
\renewcommand{\arraystretch}{1.22}
\setlength{\tabcolsep}{6pt}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\renewcommand{\tabularxcolumn}[1]{m{#1}}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}m{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}m{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}m{#1}}

% ------------------------------------------------------------- numerics ----
\RequirePackage{siunitx}
\sisetup{group-separator={,},group-minimum-digits=4,detect-weight=true,
  detect-family=true,table-number-alignment=center,tight-spacing=true}
\DeclareSIUnit{\gbp}{\textup{\pounds}}
\DeclareSIUnit{\Mgbp}{\mega\gbp}
\DeclareSIUnit{\GWh}{\giga\watt\hour}
\DeclareSIUnit{\TWh}{\tera\watt\hour}
\DeclareSIUnit{\MW}{\mega\watt}
\DeclareSIUnit{\MWh}{\mega\watt\hour}
\DeclareSIUnit{\tpd}{t\,d^{-1}}

% ------------------------------------------------------------ headings -----
\newlength{\sectionkeep}\setlength{\sectionkeep}{5\baselineskip}
% beware: \needspace needs a skip, so \sectionkeep is set in baselineskip
\RequirePackage{titlesec}
\titleformat{\section}[block]
  {\needspace{\sectionkeep}\sffamily\bfseries\large\color{accent}}{\thesection}{0.55em}{}%
  [\vspace{-0.5em}{\color{rule}\rule{\linewidth}{0.5pt}}]
\titlespacing*{\section}{0pt}{13pt plus 3pt minus 2pt}{7pt}
\titleformat{\subsection}[block]
  {\sffamily\bfseries\normalsize\color{ink}}{\thesubsection}{0.5em}{}
\titlespacing*{\subsection}{0pt}{10pt plus 2pt minus 2pt}{3pt}
\titleformat{\subsubsection}[runin]
  {\sffamily\bfseries\color{ink}}{}{0pt}{}[.]
\titlespacing*{\subsubsection}{0pt}{7pt plus 1pt}{0.5em}

% ------------------------------------------------------------- headers -----
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\newcommand{\reportrunninghead}{Tier 1 Technical Report}
\newcommand{\reportorganisation}{MMCS Group Project 2026}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{rule}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrule}{\hbox to\headwidth{\color{rule}\leaders\hrule height \footrulewidth\hfill}}
\fancyhead[L]{\footnotesize\sffamily\color{muted}\reportorganisation}
\fancyhead[R]{\footnotesize\sffamily\color{muted}\reportrunninghead}
\fancyfoot[L]{\footnotesize\sffamily\color{muted}\reportfootertext}
\fancyfoot[R]{\footnotesize\sffamily\color{muted}\thepage\,/\,\pageref{LastPage}}
\newcommand{\reportfootertext}{}
\fancypagestyle{firststyle}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\footnotesize\sffamily\color{muted}\thepage\,/\,\pageref{LastPage}}}

% ------------------------------------------------------------ title block --
\newcommand{\eyebrow}[1]{\noindent{\addfontfeatures{LetterSpace=11}\sffamily\bfseries\footnotesize
  \color{accent}#1\par}\vspace{4pt}}
\newcommand{\reporttitle}[1]{\noindent{\hyphenpenalty=10000\exhyphenpenalty=10000
  \sffamily\bfseries\fontsize{19.5}{23.5}\selectfont\color{ink}#1\par}\vspace{6pt}}
\newcommand{\reportsubtitle}[1]{\noindent{\sffamily\fontsize{11}{14.5}\selectfont
  \color{muted}#1\par}\vspace{8pt}}
% meta row: four label/value pairs, equal columns, no table machinery
\newcommand{\reportmetaitem}[2]{%
  \begin{minipage}[t]{0.245\linewidth}\raggedright
    {\sffamily\fontsize{7.5}{9}\selectfont\addfontfeatures{LetterSpace=8}%
     \color{muted}\MakeUppercase{#1}}\par\vspace{2pt}%
    {\sffamily\footnotesize\bfseries\color{ink}#2}%
  \end{minipage}\hfill}
\newenvironment{reportmeta}{%
  \par\vspace{1pt}\noindent\ignorespaces
}{%
  \par\vspace{4pt}\accentrule\vspace{9pt}%
}

% -------------------------------------------------------------- keyfigs ----
% \begin{keyfigures} \kpi{+£8.57m}{Annual increment} ... \end{keyfigures}
\newcommand{\kpi}[2]{%
  \begin{minipage}[t]{0.245\linewidth}\raggedright
    {\sffamily\bfseries\fontsize{14.5}{16.5}\selectfont\color{accent}#1}\par\vspace{1.5pt}%
    {\sffamily\fontsize{8}{10}\selectfont\color{muted}#2}%
  \end{minipage}\hfill}
\newenvironment{keyfigures}[1][Headline results]{%
  \hairrule[0.5pt]\vspace{4pt}%
  \noindent{\addfontfeatures{LetterSpace=9}\sffamily\bfseries\fontsize{7.5}{9}\selectfont
    \color{muted}\MakeUppercase{#1}\par}\vspace{4pt}%
  \noindent\ignorespaces
}{%
  \par\vspace{4pt}\hairrule[0.5pt]\vspace{9pt}%
}

% ---------------------------------------------------------------- boxes ----
\RequirePackage[most]{tcolorbox}
\newtcolorbox{decisionbox}[1][Decision]{enhanced,
  boxrule=0pt,arc=0pt,leftrule=3.2pt,colframe=accent,colback=panel,
  left=9pt,right=9pt,top=7pt,bottom=7pt,
  fonttitle=\sffamily\bfseries\footnotesize\addfontfeatures{LetterSpace=9},
  coltitle=accent,attach title to upper={\par\vspace{3pt}},
  title={#1},before skip=8pt,after skip=8pt}
\newtcolorbox{caveatbox}[1][Caveat]{enhanced,
  boxrule=0pt,arc=0pt,leftrule=3.2pt,colframe=warn,colback=panelwarn,
  left=9pt,right=9pt,top=7pt,bottom=7pt,
  fonttitle=\sffamily\bfseries\footnotesize\addfontfeatures{LetterSpace=9},
  coltitle=warn,attach title to upper={\par\vspace{3pt}},
  title={#1},before skip=8pt,after skip=8pt}

% ------------------------------------------------------------- captions ----
\RequirePackage{caption}
\captionsetup{font=small,labelfont={sf,bf},labelsep=period,
  textfont={color=ink},justification=raggedright,singlelinecheck=false,skip=5pt}
\captionsetup[table]{position=above,labelfont={sf,bf,color=accent}}
\captionsetup[figure]{position=below,labelfont={sf,bf,color=accent}}
\newcommand{\srcnote}[1]{\par\vspace{4pt}{\raggedright\footnotesize\color{muted}#1\par}}
\newcommand{\figsrc}[1]{\par\vspace{3pt}{\raggedright\footnotesize\color{muted}#1\par}}

% ---------------------------------------------------------------- lists ----
\RequirePackage{enumitem}
\setlist[itemize]{leftmargin=1.2em,topsep=3pt,itemsep=1.5pt,parsep=0pt}
\setlist[enumerate]{leftmargin=1.6em,topsep=3pt,itemsep=2.5pt,parsep=0pt,
  label=\sffamily\bfseries\color{accent}\arabic*.}

% ---------------------------------------------------------------- maths ----
\RequirePackage{amsmath}
\setlength{\abovedisplayskip}{6pt plus 2pt minus 2pt}
\setlength{\belowdisplayskip}{6pt plus 2pt minus 2pt}
\newcommand{\key}[1]{\textbf{\color{accent}#1}}

% ----------------------------------------------------------- references ----
\RequirePackage[hidelinks]{hyperref}
\urlstyle{same}

% placeholder marker used throughout the template
\newcommand{\ph}[1]{{\color{muted}\itshape[#1]}}
\endinput
